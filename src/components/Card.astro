---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  href: string;
  title: string;
  meta: string;
  summary: string;
  cover?: ImageMetadata;
  /** 'contain' shows the whole image on a white panel instead of cropping it to fill. */
  fit?: 'cover' | 'contain';
}

const { href, title, meta, summary, cover, fit = 'cover' } = Astro.props;
---

<article class="card">
  {
    cover && (
      <a class={`cover ${fit}`} href={href} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" width={720} />
      </a>
    )
  }
  <h3><a href={href}>{title}</a></h3>
  <p class="meta">{meta}</p>
  <p>{summary}</p>
</article>

<style>
  .card {
    overflow: hidden;
  }

  .cover {
    display: block;
    margin: -1.25rem -1.25rem 1rem;
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .cover.contain {
    background: #fff;
    border-bottom: 1px solid var(--border);
  }

  .cover.contain img {
    object-fit: contain;
    padding: 0.75rem;
  }
</style>
