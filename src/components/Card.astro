---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  href: string;
  title: string;
  meta: string;
  summary: string;
  tags?: string[];
  cover?: ImageMetadata;
}

const { href, title, meta, summary, tags = [], cover } = Astro.props;
---

<article class="card">
  {
    cover && (
      <a class="cover" href={href} tabindex="-1" aria-hidden="true">
        <Image src={cover} alt="" width={720} />
      </a>
    )
  }
  <h3><a href={href}>{title}</a></h3>
  <p class="meta">{meta}</p>
  <p>{summary}</p>
  <ul class="tags">
    {tags.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
</article>

<style>
  .card {
    overflow: hidden;
  }

  .cover {
    display: block;
    margin: -1.25rem -1.25rem 1rem;
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
</style>
