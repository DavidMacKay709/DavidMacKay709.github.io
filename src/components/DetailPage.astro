---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  backHref: string;
  backLabel: string;
  title: string;
  meta: string;
  cover?: ImageMetadata;
}

const { backHref, backLabel, title, meta, cover } = Astro.props;
---

<p class="back"><a href={backHref}>← {backLabel}</a></p>
<header class="page-header">
  <h1>{title}</h1>
  <p class="lede">{meta}</p>
</header>

{cover && <Image class="hero-image" src={cover} alt="" width={1200} />}

<article class="prose">
  <slot />
</article>

<style>
  .back {
    margin: 1.5rem 0 0;
  }

  .page-header {
    padding-top: 1rem;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 1.5rem;
  }

  .prose :global(h2) {
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
  }

  .prose :global(figure) {
    margin: 1.5rem 0;
  }

  .prose :global(figure img) {
    margin: 0 auto;
    background: #fff;
  }

  .prose :global(img + .caption),
  .prose :global(p:has(> img) + .caption) {
    margin-top: -1rem;
  }

  .prose :global(figcaption),
  .prose :global(.caption) {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .prose :global(h3) {
    font-size: 1.05rem;
    margin: 1.5rem 0 0.5rem;
  }

  /* Video embeds (YouTube etc.) */
  .prose :global(iframe) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    margin: 1.5rem 0;
  }
</style>
