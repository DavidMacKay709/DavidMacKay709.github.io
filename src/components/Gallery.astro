---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  images: ImageMetadata[];
  title: string;
  heading?: string;
  aspect?: string;
}

const { images, title, heading, aspect = '3 / 2' } = Astro.props;

// Full-size versions for the slideshow; the grid uses smaller thumbnails.
const photos = await Promise.all(
  images.map(async (src, i) => ({
    src,
    alt: `${title}, photo ${i + 1} of ${images.length}`,
    full: await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' }),
  })),
);
---

<section class="gallery-section" style={`--thumb-aspect: ${aspect}`}>
  {heading && <h2>{heading}</h2>}
  <ul class="gallery">
    {
      photos.map((photo, i) => (
        <li>
          <a href={photo.full.src} data-index={i} data-alt={photo.alt}>
            <Image src={photo.src} alt={photo.alt} width={480} loading="lazy" />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img alt="" />
    <p class="counter" aria-live="polite"></p>
    <button class="close" type="button" aria-label="Close">×</button>
    <button class="prev" type="button" aria-label="Previous photo">‹</button>
    <button class="next" type="button" aria-label="Next photo">›</button>
  </dialog>
</section>

<style>
  .gallery-section {
    margin-top: 1.25rem;
  }

  .gallery-section h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }

  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10rem), 1fr));
    gap: 0.5rem;
  }

  .gallery a {
    display: block;
    overflow: hidden;
  }

  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--thumb-aspect);
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .gallery a:hover img,
  .gallery a:focus-visible img {
    transform: scale(1.04);
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.94);
    color: #fff;
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.94);
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    touch-action: pan-y pinch-zoom;
  }

  .counter {
    position: absolute;
    top: 0.75rem;
    left: 1rem;
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .lightbox button {
    position: absolute;
    background: rgb(0 0 0 / 0.4);
    color: #fff;
    border: 0;
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox button:hover,
  .lightbox button:focus-visible {
    background: rgb(255 255 255 / 0.2);
  }

  .close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .prev,
  .next {
    top: 50%;
    transform: translateY(-50%);
  }

  .prev {
    left: 0.5rem;
  }

  .next {
    right: 0.5rem;
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('.gallery-section')) {
    const links = [...section.querySelectorAll<HTMLAnchorElement>('.gallery a')];
    const dialog = section.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    const counter = dialog.querySelector('.counter')!;
    let index = 0;

    const preload = (i: number) => {
      const link = links[(i + links.length) % links.length];
      if (link) new Image().src = link.href;
    };

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      img.src = links[index].href;
      img.alt = links[index].dataset.alt ?? '';
      counter.textContent = `${index + 1} / ${links.length}`;
      preload(index + 1);
      preload(index - 1);
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );

    dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());

    // Click on the dark background (not the photo or buttons) closes the viewer.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    // Swipe left/right on touch screens.
    let startX: number | null = null;
    dialog.addEventListener('pointerdown', (event) => (startX = event.clientX));
    dialog.addEventListener('pointerup', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1);
    });
  }
</script>
