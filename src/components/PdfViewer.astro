---
interface Props {
  src: string;
  title: string;
  pages?: number;
}

const { src, title, pages } = Astro.props;
---

<figure class="pdf">
  <div class="pdf-actions">
    <a class="button" href={src} target="_blank" rel="noopener">Read the full report</a>
    <a class="button secondary" href={src} download>Download PDF{pages && ` (${pages} pages)`}</a>
  </div>
  <iframe src={src} title={title} loading="lazy"></iframe>
</figure>

<style>
  .pdf {
    margin: 1.5rem 0 2.5rem;
  }

  .pdf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  iframe {
    display: block;
    width: 100%;
    height: 80vh;
    border: 1px solid var(--border);
  }

  /* Phones can't scroll an embedded PDF well; the buttons above open it full-screen instead. */
  @media (max-width: 640px) {
    iframe {
      display: none;
    }
  }
</style>
