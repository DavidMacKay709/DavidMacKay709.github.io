---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'David MacKay',
  description = 'Work, projects, and writing by David MacKay.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">David MacKay</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} David MacKay</p>
      <a href="https://github.com/DavidMacKay709">GitHub</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --text: #1c1917;
    --muted: #57534e;
    --accent: #2563eb;
    --border: #e7e5e4;
    --max-width: 44rem;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141414;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --accent: #60a5fa;
      --border: #292524;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  a {
    color: var(--accent);
  }

  main,
  .site-header,
  .site-footer {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem;
  }

  main {
    flex: 1;
  }

  .site-header {
    padding-block: 1.5rem;
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding-block: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0;
  }
</style>
