---
interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'David MacKay, energy systems engineer (E.I.T.): power system modelling, optimization, and expeditions.',
} = Astro.props;

const pageTitle = title ? `${title} | David MacKay` : 'David MacKay | Energy Systems Engineer';

const nav = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },  { href: '/expeditions/', label: 'The Great Outdoors' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const base = href.replace(/\/$/, '');
  return path === base || path.startsWith(`${base}/`);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">David MacKay</a>
      <nav aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} David MacKay</p>
      <div class="footer-links">
        <a href="mailto:davidmackay709@gmail.com">Email</a>
        <a href="https://github.com/DavidMacKay709">GitHub</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --surface: #ffffff;
    --text: #1c1917;
    --muted: #57534e;
    --accent: #0f766e;
    --accent-soft: #ccfbf1;
    --border: #e7e5e4;
    --max-width: 48rem;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121413;
      --surface: #1a1d1c;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --accent: #2dd4bf;
      --accent-soft: #134e4a;
      --border: #2a2e2d;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2,
  h3 {
    line-height: 1.2;
  }

  main,
  .site-header,
  .site-footer {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem;
  }

  main {
    flex: 1;
  }

  /* Header */
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem;
  }

  .brand {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .site-header nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-header nav a:hover,
  .site-header nav a[aria-current='page'] {
    color: var(--text);
  }

  .site-header nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  /* Footer */
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    border-top: 1px solid var(--border);
    margin-top: 4rem;
    padding-block: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  /* Shared page pieces */
  .page-header {
    padding-block: 2.5rem 1rem;
  }

  .page-header h1 {
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    margin: 0 0 0.5rem;
  }

  .lede {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0;
  }

  .section {
    margin-top: 3rem;
  }

  .section-title {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin: 0 0 1.25rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .card h3 {
    margin: 0 0 0.25rem;
    font-size: 1.1rem;
  }

  .card .meta {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }

  .card p {
    margin: 0 0 1rem;
  }

  .button {
    display: inline-block;
    background: var(--accent);
    color: var(--bg);
    border-radius: 0.5rem;
    padding: 0.55rem 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .button.secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
</style>
