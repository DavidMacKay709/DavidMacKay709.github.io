---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import chargingProfiles from '../../assets/coursework/charging-profiles.png';
---

<BaseLayout title="Coursework" description="Engineering coursework by David MacKay at Carleton University.">
  <header class="page-header">
    <h1>Coursework</h1>
    <p class="lede">
      Selected work from my Bachelor of Engineering (Aerospace and Mechanical) at Carleton University.
    </p>
  </header>

  <div class="card-grid">
    <Card
      href="/coursework/capstone/"
      title="Capstone: Ottawa's 2050 Energy System"
      meta="Sustainable Energy Systems Portfolio · 2023 – 2024"
      summary="Integration team lead for 25+ students, projecting Ottawa's 2050 EV load and building a least-cost optimization model of the city's future energy system."
      tags={['MATLAB', 'MILP', 'EV demand', 'Capacity planning']}
      cover={chargingProfiles}
    />
    <Card
      href="/coursework/reports/"
      title="Other Reports"
      meta="AERO 4442A · Transatmospheric and Space Propulsion"
      summary="Propulsion assignments: combustion equilibrium by Gibbs free energy minimization, and a sounding rocket trajectory simulation."
      tags={['MATLAB', 'Propulsion', 'Numerical simulation']}
    />
  </div>
</BaseLayout>
