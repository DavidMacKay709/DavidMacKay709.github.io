---
import BaseLayout from '../layouts/BaseLayout.astro';

const expeditions = [
  {
    title: 'Canoe Expedition Through Canada\'s Arctic',
    when: 'Summer 2026',
    stats: ['70 days', 'Self-supported'],
    body: 'Team member on a 70-day self-supported canoe expedition through Canada\'s remote Arctic. I led planning of the route, the safety plan, and the food.',
  },
  {
    title: 'Circumnavigation of Newfoundland by Sea Kayak',
    when: 'Summer 2024',
    stats: ['49 days', '2,200+ km', 'Expedition leader'],
    body: 'Led a 49-day sea kayak expedition around the island of Newfoundland, covering more than 2,200 km. I was responsible for route planning, risk assessment, safety protocols, and finding sponsors.',
  },
  {
    title: 'Yukon River Quest',
    when: 'July 2023',
    stats: ['715 km', '4th in division'],
    body: 'Competed in the world\'s longest annual paddling race and placed 4th in my division.',
  },
  {
    title: 'Grand Canyon Whitewater Rafting',
    when: 'January 2023',
    stats: ['28 days', 'Self-guided'],
    body: 'A 28-day self-guided rafting trip down the Colorado River through the Grand Canyon.',
  },
];
---

<BaseLayout title="Expeditions" description="Sea kayak, canoe, and whitewater expeditions by David MacKay.">
  <header class="page-header">
    <h1>Expeditions</h1>
    <p class="lede">
      Long, self-supported trips by kayak, canoe, and raft. Planning them has taught me a lot
      about risk assessment and staying calm when conditions change.
    </p>
  </header>

  <ol class="timeline">
    {
      expeditions.map((trip) => (
        <li class="card">
          <p class="meta">{trip.when}</p>
          <h3>{trip.title}</h3>
          <ul class="tags">
            {trip.stats.map((stat) => <li class="tag">{stat}</li>)}
          </ul>
          <p class="body">{trip.body}</p>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .timeline .tags {
    margin: 0.5rem 0 0.75rem;
  }

  .body {
    margin: 0;
  }
</style>
