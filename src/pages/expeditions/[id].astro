---
import type { ImageMetadata } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailPage from '../../components/DetailPage.astro';
import Gallery from '../../components/Gallery.astro';
import RouteMap from '../../components/RouteMap.astro';
import { routeLines } from '../../lib/routes';

export async function getStaticPaths() {
  const expeditions = await getCollection('expeditions');
  return expeditions.map((expedition) => ({
    params: { id: expedition.id },
    props: { expedition },
  }));
}

interface Props {
  expedition: CollectionEntry<'expeditions'>;
}

const { expedition } = Astro.props;
const { title, summary, when, cover, route } = expedition.data;
const { Content } = await render(expedition);

// A trip with no line in its route file yet just gets the plain page header.
const lines = route ? routeLines(route) : [];

// Any images in src/content/expeditions/<id>/photos/ become the page's gallery,
// ordered by the number in the filename (so "...-44.jpg" comes before "...-109.jpg").
const allPhotos = import.meta.glob<ImageMetadata>(
  '/src/content/expeditions/*/photos/*.{jpg,jpeg,png,webp}',
  { eager: true, import: 'default' },
);
const prefix = `/src/content/expeditions/${expedition.id}/photos/`;
const photos = Object.keys(allPhotos)
  .filter((path) => path.startsWith(prefix))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((path) => allPhotos[path]);

// Trip log entries (src/content/expeditions/<id>/log/*.md), oldest first.
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const logEntries = (await getCollection('tripLog', (entry) => entry.id.startsWith(`${expedition.id}/`))).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id),
);
const log = await Promise.all(
  logEntries.map(async (entry) => ({
    entry,
    anchor: entry.id.split('/').pop(),
    date: formatDate(entry.data.date),
    Content: (await render(entry)).Content,
  })),
);
---

<BaseLayout title={title} description={summary}>
  <DetailPage
    backHref="/expeditions/"
    backLabel="The Great Outdoors"
    title={title}
    meta={when}
    cover={cover}
    onMap={lines.length > 0}
  >
    {lines.length > 0 && <RouteMap slot="map" lines={lines} />}
    <Content />
  </DetailPage>

  {photos.length > 0 && <Gallery images={photos} title={title} heading="Photos" />}

  {
    log.length > 0 && (
      <section class="trip-log">
        <h2>Trip log</h2>
        {log.map(({ entry, anchor, date, Content }) => (
          <article class="log-entry" id={anchor}>
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>{date}</time>
            <div class="log-body">
              <Content />
            </div>
            {entry.data.photos.length > 0 && (
              <Gallery images={entry.data.photos} title={`${title}, ${date}`} aspect="1 / 1" />
            )}
          </article>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .trip-log {
    margin-top: 3rem;
  }

  .trip-log h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }

  .log-entry {
    border-top: 1px solid var(--border);
    padding-block: 1.75rem;
  }

  .log-entry time {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .log-body :global(p) {
    margin: 0 0 0.9rem;
  }

  .log-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
