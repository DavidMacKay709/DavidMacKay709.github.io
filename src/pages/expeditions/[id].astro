---
import type { ImageMetadata } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailPage from '../../components/DetailPage.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const expeditions = await getCollection('expeditions');
  return expeditions.map((expedition) => ({
    params: { id: expedition.id },
    props: { expedition },
  }));
}

interface Props {
  expedition: CollectionEntry<'expeditions'>;
}

const { expedition } = Astro.props;
const { title, summary, when, cover } = expedition.data;
const { Content } = await render(expedition);

// Any images in src/content/expeditions/<id>/photos/ become the page's gallery,
// ordered by the number in the filename (so "...-44.jpg" comes before "...-109.jpg").
const allPhotos = import.meta.glob<ImageMetadata>(
  '/src/content/expeditions/*/photos/*.{jpg,jpeg,png,webp}',
  { eager: true, import: 'default' },
);
const prefix = `/src/content/expeditions/${expedition.id}/photos/`;
const photos = Object.keys(allPhotos)
  .filter((path) => path.startsWith(prefix))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  .map((path) => allPhotos[path]);
---

<BaseLayout title={title} description={summary}>
  <DetailPage
    backHref="/expeditions/"
    backLabel="The Great Outdoors"
    title={title}
    meta={when}
    cover={cover}
  >
    <Content />
  </DetailPage>
  {photos.length > 0 && <Gallery images={photos} title={title} />}
</BaseLayout>
