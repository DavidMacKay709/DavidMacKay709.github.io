---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { expeditionCard } from '../../lib/cards';

const expeditions = (await getCollection('expeditions')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="The Great Outdoors" description="Sea kayak, canoe, and whitewater expeditions by David MacKay.">
  <header class="page-header">
    <h1>The Great Outdoors</h1>
  </header>

  <div class="card-grid">
    {expeditions.map((expedition) => <Card {...expeditionCard(expedition)} summary={undefined} />)}
  </div>
</BaseLayout>
