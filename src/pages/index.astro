---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <h1>Hi, I'm David.</h1>
    <p>
      This is my corner of the internet: work, projects, and the occasional personal post.
      The site is under construction, so check back soon.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 4rem 2rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.1;
    margin: 0 0 1rem;
  }

  p {
    color: var(--muted);
    font-size: 1.15rem;
    margin: 0;
  }
</style>
