---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { expeditionCard, projectCard } from '../lib/cards';

const [projects, expeditions] = await Promise.all([
  getCollection('projects'),
  getCollection('expeditions'),
]);

const featured = [
  ...expeditions.map((e) => ({ rank: e.data.featured, card: expeditionCard(e) })),
  ...projects.map((p) => ({ rank: p.data.featured, card: projectCard(p) })),
]
  .filter((item): item is typeof item & { rank: number } => item.rank !== undefined)
  .sort((a, b) => a.rank - b.rank);
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Energy Systems Engineer (E.I.T.) · St. John's, NL</p>
    <h1>I build optimization models for power systems.</h1>
    <p class="lede">
      I'm David MacKay. At Angler Solutions I help lead development of the optimization
      module for MESO, a Python/Pyomo platform for capacity expansion and hourly dispatch.
      I'm especially interested in power markets. Outside work, I plan and lead long
      expeditions by kayak and canoe.
    </p>
    <div class="actions">
      <a class="button" href="/projects/">See my work</a>
      <a class="button secondary" href="/expeditions/">The Great Outdoors</a>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Featured</h2>
    <div class="card-grid">
      {featured.map(({ card }) => <Card {...card} />)}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Get in touch</h2>
    <p>
      I'm always happy to talk about energy systems, optimization, or power markets. Email me at <a
        href="mailto:davidmackay709@gmail.com">davidmackay709@gmail.com</a
      >.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: 3.5rem 1rem;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin: 0 0 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
