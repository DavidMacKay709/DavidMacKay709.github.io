---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { projectCard } from '../../lib/cards';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Projects" description="Power system modelling, optimization, and research projects by David MacKay.">
  <header class="page-header">
    <h1>Projects</h1>
    <p class="lede">Power system modelling, optimization, and energy research.</p>
  </header>

  <div class="card-grid">
    {projects.map((project) => <Card {...projectCard(project)} />)}
  </div>
</BaseLayout>
