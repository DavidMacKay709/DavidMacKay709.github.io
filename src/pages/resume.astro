---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    role: 'Energy Systems E.I.T.',
    org: 'Angler Solutions, St. John\'s, NL',
    when: 'Feb 2026 – Present',
    points: [
      'Led development and documentation of the optimization module for MESO (Model for Energy Systems Optimization), a Python/Pyomo platform for capacity expansion and hourly dispatch optimization.',
      'Built the hourly dispatch engine. Generators, dynamic loads, grid imports/exports, and hydrogen/ammonia assets are dispatched against time-of-use rates using locational marginal pricing.',
      'Developed a model architecture that lets users choose the modelling mode: stochastic optimization, rolling horizon dispatch, representative periods, Benders decomposition, or full-year deterministic.',
      'Made temporal resolution, existing and candidate generators, integer or continuous investment decisions, and model complexity (linearization, ramping, start-up/shut-down costs, unit commitment) user-selectable.',
      'Developed a statistical model for predicting wind turbine production losses due to icing, to inform day-ahead bidding strategy.',
    ],
  },
  {
    role: 'Research Associate',
    org: 'APEX Research Group, Carleton University, ON',
    when: 'Sep 2024 – Sep 2025',
    points: [
      'Second author, "Hydrogen microgrids to facilitate the clean energy transition in remote, northern communities", Applied Energy, 2025. Took over the project and led it to completion: added solar PV to the methods, wrote and reviewed the updated manuscript, developed visualization methods, and handled reviewer revisions.',
      'Developed methods for a paper on the effects of temporal resolution when modelling wind, solar, and hydrogen microgrids.',
      'Built a 10-node model of the Canadian grid with linearized DC power flow and multistage stochastic optimization to identify "no regret" decisions under uncertainty.',
    ],
  },
  {
    role: 'Research Assistant',
    org: 'Northern Energy Innovation, Whitehorse, YT',
    when: 'May 2023 – May 2024',
    points: [
      'Developed MATLAB/Simulink power system models for remote community grids alongside Professional Engineers and technicians.',
      'Surveyed and documented community power system infrastructure in the field, from generator to load.',
      'Ran power system impact studies assessing new generation interconnections and new loads on isolated grids.',
      'Applied graph theory to analyze community power system topology and identify vulnerabilities.',
    ],
  },
  {
    role: 'Integration Team Lead',
    org: 'Sustainable Energy Systems Portfolio, Carleton University, ON',
    when: 'Sep 2023 – May 2024',
    points: [
      'Led integration for a multidisciplinary team of 25+ students.',
      'Projected Ottawa\'s EV energy demand from 2023 through 2050.',
      'Built a least-cost investment planning model (wind, nuclear, solar, load-side efficiency) to reach net zero by 2050, with sensitivity analysis across future scenarios.',
    ],
  },
  {
    role: 'Owner & Operator',
    org: 'Whitefish Landscaping, St. John\'s & Ottawa',
    when: 'May 2021 – Dec 2022',
    points: [
      'Started and ran a contracting business with over $150,000 in sales.',
      'Managed client relationships, procurement, safety planning, and project delivery to meet the National Building Code of Canada.',
    ],
  },
];

const leadership = [
  { role: 'Team Member', what: '70-day canoe expedition through Canada\'s Arctic', when: 'Summer 2026' },
  { role: 'Expedition Leader', what: 'Circumnavigation of Newfoundland by sea kayak (49 days, 2,200+ km)', when: 'Summer 2024' },
  { role: 'Competitor', what: 'Yukon River Quest, 715 km (4th in division)', when: 'Jul 2023' },
  { role: 'Team Member', what: 'Grand Canyon whitewater rafting expedition (28 days)', when: 'Jan 2023' },
  { role: 'Varsity Athlete', what: 'Carleton University men\'s water polo', when: 'Sep 2019 – May 2022' },
];
---

<BaseLayout title="Resume" description="Resume of David MacKay, energy systems engineer (E.I.T.).">
  <header class="page-header">
    <h1>Resume</h1>
    <p class="lede">
      David MacKay, E.I.T. · <a href="mailto:davidmackay709@gmail.com">davidmackay709@gmail.com</a>
    </p>
  </header>

  <section class="section">
    <h2 class="section-title">Education</h2>
    <div class="entry">
      <div class="entry-head">
        <h3>Carleton University</h3>
        <span class="when">Sep 2019 – May 2025</span>
      </div>
      <p class="org">Bachelor of Engineering (Aerospace and Mechanical)</p>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Experience</h2>
    {
      experience.map((job) => (
        <div class="entry">
          <div class="entry-head">
            <h3>{job.role}</h3>
            <span class="when">{job.when}</span>
          </div>
          <p class="org">{job.org}</p>
          <ul>
            {job.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="section">
    <h2 class="section-title">Leadership & Extracurricular</h2>
    {
      leadership.map((item) => (
        <div class="entry compact">
          <div class="entry-head">
            <h3>
              {item.role} <span class="what">· {item.what}</span>
            </h3>
            <span class="when">{item.when}</span>
          </div>
        </div>
      ))
    }
  </section>

  <section class="section">
    <h2 class="section-title">Skills</h2>
    <p>
      Python (pandas, NumPy, Pyomo), MATLAB/Simulink, Git, Excel, LaTeX · mixed-integer linear
      programming, multi-stage stochastic optimization, Benders decomposition · unit dispatch and
      storage scheduling, capacity expansion planning, interconnection studies, renewable integration
      (wind, solar, BESS, hydrogen) · NPV, lifecycle cost, LCOE/LCOA, discounted cash flow,
      sensitivity and scenario analysis · English (native), French (intermediate)
    </p>
  </section>
</BaseLayout>

<style>
  .entry {
    margin-bottom: 1.75rem;
  }

  .entry.compact {
    margin-bottom: 0.75rem;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1rem;
  }

  .entry h3 {
    font-size: 1.05rem;
    margin: 0;
  }

  .what {
    font-weight: 400;
    color: var(--muted);
  }

  .when {
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .org {
    margin: 0.1rem 0 0.5rem;
    color: var(--muted);
  }

  ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  li {
    margin-bottom: 0.35rem;
  }
</style>
