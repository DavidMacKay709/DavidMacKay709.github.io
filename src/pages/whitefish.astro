---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';

// Each project's photos live in src/assets/whitefish/<folder>/, ordered by filename.
const projects = [
  { folder: 'cabin', title: 'Cabin Renovation' },
  { folder: 'retaining-wall', title: 'Retaining Wall, Patio, and Shed' },
  { folder: 'shed', title: 'Single-Slope Roof Shed Build' },
  { folder: 'fence', title: 'Fence and Decorative Gate with Pergola' },
  { folder: 'garden-fence', title: 'Rustic Garden Fence' },
  { folder: 'channel-drain', title: 'Channel Drain for Underground Garages' },
  { folder: 'other', title: 'Other Projects' },
];

const allPhotos = import.meta.glob<ImageMetadata>('/src/assets/whitefish/*/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photosIn = (folder: string) =>
  Object.keys(allPhotos)
    .filter((path) => path.startsWith(`/src/assets/whitefish/${folder}/`))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
    .map((path) => allPhotos[path]);
---

<BaseLayout
  title="Whitefish"
  description="Whitefish Landscaping, the landscaping and contracting business David MacKay started and ran in Ottawa and St. John's."
>
  <header class="page-header">
    <h1>Whitefish</h1>
    <p class="lede">Owner & Operator · Ottawa & St. John's · 2021 – 2022</p>
  </header>

  <p>See some of our work.</p>

  {
    projects.map(({ folder, title }) => {
      const photos = photosIn(folder);
      return photos.length > 0 && <Gallery images={photos} title={title} heading={title} />;
    })
  }
</BaseLayout>
